{
  "compilerOptions": {
    "target": "ES2022",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,
    "noEmit": true,

    "types": ["node"],

    "typeRoots": [
      "./node_modules/@types"
    ]
  },

  "include": [
    "server.ts"
  ],

  "exclude": [
    "node_modules"
  ]
}